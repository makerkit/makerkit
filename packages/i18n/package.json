{
  "name": "@makerkit/i18n",
  "version": "0.0.1",
  "description": "Lets coding agents read and edit JSON translation files stored as <locale>/<namespace>.json (i18next, next-i18next, next-intl with namespace files): list, update, stats, add and remove locales and namespaces.",
  "keywords": [
    "ai-agents",
    "i18n",
    "i18next",
    "mcp",
    "next-intl",
    "translations"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/makerkit/makerkit",
    "directory": "packages/i18n"
  },
  "main": "./index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./node": {
      "types": "./node.d.ts",
      "import": "./node.mjs",
      "require": "./node.js"
    },
    "./mcp": {
      "types": "./mcp.d.ts",
      "import": "./mcp.mjs",
      "require": "./mcp.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "linkDirectory": true
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/prepare-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  }
}
