    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "ts-case-convert": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@supabase/postgrest-js": ">=2.0.0",
    "@supabase/supabase-js": ">=2.74.0"
  }
}
