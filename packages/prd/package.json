{
  "name": "@makerkit/prd",
  "version": "0.0.2",
  "description": "Structured PRDs as JSON files: the format, a service to manage them, and MCP tools so coding agents can read and update them.",
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "mcp",
    "prd",
    "product-requirements"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/makerkit/makerkit",
    "directory": "packages/prd"
  },
  "main": "./index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./node": {
      "types": "./node.d.ts",
      "import": "./node.mjs",
      "require": "./node.js"
    },
    "./mcp": {
      "types": "./mcp.d.ts",
      "import": "./mcp.mjs",
      "require": "./mcp.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "linkDirectory": true
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/prepare-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@makerkit/repo-checks": "workspace:^",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  }
}
