{
  "name": "@makerkit/source",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Makerkit",
    "url": "https://makerkit.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/makerkit/makerkit"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "oxlint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "oxfmt --check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "typegen": "supabase gen types typescript --local > supabase/database.types.ts",
    "healthcheck": "oxlint && oxfmt --check && turbo run typecheck test",
    "lint:fix": "oxlint --fix",
    "format:fix": "oxfmt"
  },
  "dependencies": {
    "supabase": "^2.120.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsdown": "catalog:",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.25.0"
}
